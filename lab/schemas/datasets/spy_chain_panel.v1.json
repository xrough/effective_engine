{
  "schema_id": "spy_chain_panel.v1",
  "asset": "SPY",
  "grain": "intraday_option_chain_panel",
  "primary_timestamp": "timestamp_utc",
  "required_columns": [
    "timestamp_utc",
    "underlying_price",
    "atm_strike",
    "expiry_date",
    "time_to_expiry",
    "call_mid",
    "put_mid",
    "call_bid",
    "call_ask",
    "put_bid",
    "put_ask",
    "atm_iv",
    "call25d_strike",
    "call25d_mid",
    "call25d_bid",
    "call25d_ask",
    "put25d_strike",
    "put25d_mid",
    "put25d_bid",
    "put25d_ask",
    "rr25_iv",
    "bf25_iv",
    "vix_varswap",
    "ssvi_rho",
    "ssvi_phi",
    "rv5_ann"
  ],
  "positive_columns": [
    "underlying_price",
    "atm_strike",
    "time_to_expiry",
    "call_mid",
    "put_mid",
    "call_bid",
    "call_ask",
    "put_bid",
    "put_ask",
    "atm_iv",
    "call25d_strike",
    "call25d_mid",
    "call25d_bid",
    "call25d_ask",
    "put25d_strike",
    "put25d_mid",
    "put25d_bid",
    "put25d_ask",
    "vix_varswap",
    "ssvi_phi"
  ],
  "nonnegative_columns": ["rv5_ann"],
  "finite_signed_columns": ["rr25_iv", "bf25_iv", "ssvi_rho"],
  "quote_bounds": [
    ["call_bid", "call_mid", "call_ask"],
    ["put_bid", "put_mid", "put_ask"],
    ["call25d_bid", "call25d_mid", "call25d_ask"],
    ["put25d_bid", "put25d_mid", "put25d_ask"]
  ],
  "walk_forward": {
    "default_min_train_days": 3,
    "causality_rule": "all training rows must have timestamp dates strictly before deploy_date"
  }
}
